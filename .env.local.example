# Scandit SDK License Key (optional - native BarcodeDetector is used by default)
# Get your license key from https://www.scandit.com/
NEXT_PUBLIC_SCANDIT_LICENSE_KEY=your-scandit-license-key-here

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
TELEGRAM_BOT_WEBHOOK_URL=https://your-bot-webhook-url.railway.app

# Supabase Configuration (server-only — service-role key bypasses RLS).
# NEVER expose the service-role key to the browser.
# Get these from your Supabase project: Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Image storage: Supabase Storage (public bucket `warehouse-images`).
# No extra config needed — reuses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# (Cloudinary was removed; the /api/cloudinary/upload route now writes to Supabase.)

# OpenRouter API Configuration
# Required for LLM cross-validation during invoice matching
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# LPN Sticker Signature Secret
# Shared with the bot (Railway: LPN_SECRET env var). Used to compute the
# WHPL- HMAC embedded in printed-sticker QR payloads so the bot can
# uniquely identify our own stickers vs. invoice photos / arbitrary QRs.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and set the SAME value on both Vercel (scanner) and Railway (bot).
LPN_SECRET=your-32-byte-hex-secret-here
